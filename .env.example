# Local Compose: generate real values with node scripts/setup-env.js
SESSION_SECRET=replace-with-at-least-32-random-characters
MONGO_PASSWORD=replace-with-a-random-hex-password
# Native Node development needs a reachable MongoDB URI.
MONGODB_URI=mongodb://127.0.0.1:27017/sandbee_gstin
MONGODB_DB=sandbee_gstin
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# Production: copy this file to .env.production, replace secrets and MongoDB URI.
DOMAIN=gstapi.sandbee.in

# Set both to deliver through Gmail. Spaces in a Google App Password are accepted.
# Leave blank locally to use the Docker email inbox at http://localhost:8026.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional verified Gmail sender alias; otherwise GMAIL_USER is used.
MAIL_FROM=
MAILPIT_PORT=8026
